# URL pública ou local da sua Evolution API, sem barra no final
EVOLUTION_API_URL=http://localhost:8080
# Chave global ou da instância configurada na Evolution API
EVOLUTION_API_KEY=
# Nome exato da instância conectada ao WhatsApp
EVOLUTION_INSTANCE=atelier
# URL pública da Edge Function evolution-webhook
EVOLUTION_WEBHOOK_URL=
# Segredo enviado pela Evolution no cabeçalho do webhook
EVOLUTION_WEBHOOK_SECRET=
# Respostas automáticas restritas ao contato autorizado
EVOLUTION_AUTO_REPLY_ENABLED=false
EVOLUTION_AUTO_REPLY_PHONE=557183915543
EVOLUTION_WEBHOOK_SECRET=change-this-local-webhook-secret
